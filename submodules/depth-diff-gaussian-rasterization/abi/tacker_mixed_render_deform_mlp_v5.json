{
  "abi_version": 5,
  "backend_family": "full_deform_mlp_v5",
  "name": "4dgs_exact_raster_render_plus_full_deform_mlp",
  "rasterizer_upstream_commit": "e49506654e8e11ed8a62d22bcb693e943fdecacf",
  "cuda_arch": "sm_86",
  "pointer_size_bytes": 8,
  "preserved_abis": [
    "abi/tacker_mixed_render_head_v1.json",
    "abi/tacker_mixed_render_heads_v2.json",
    "abi/tacker_mixed_render_packed_heads_v3.json",
    "abi/tacker_mixed_render_whole_heads_v4.json"
  ],
  "tacker_ext_dependency": {
    "manifest": "tacker_ext/abi/deform_mlp_v1.json",
    "manifest_sha256": "1c8112a30ce8c5075689d3bd5ed03b8aaadbdcdf29f86cf92ee0a725af3b4900",
    "header": "deform_mlp_device.cuh",
    "device_adapter": "tacker_4dgs::deform_mlp_gptb_device_v1"
  },
  "global_kernel_symbol": "tacker_mix_render_deform_mlp_v5",
  "physical_launch": {
    "threads": 384,
    "persistent_blocks_zero_policy": "direct logical grid",
    "physical_blocks_zero_resolution": "max(raster_logical_blocks, ceil_div(deform_rows, 16))",
    "positive_persistent_blocks_clamp": "[1, logical_blocks]",
    "persistent_step": "physical_blocks",
    "dynamic_shared_memory_bytes": 0,
    "deform_static_shared_scratch_bytes": 14592
  },
  "subgroups": {
    "raster": {
      "thread_range": [0, 255],
      "threads": 256,
      "device_adapter": "CudaRasterizer::Tacker::general_ptb_render<NUM_CHANNELS>",
      "named_barrier_id": 1,
      "named_barrier_participants": 256
    },
    "deform_mlp": {
      "thread_range": [256, 383],
      "threads": 128,
      "device_adapter": "tacker_4dgs::deform_mlp_gptb_device_v1",
      "named_barrier_id": 2,
      "named_barrier_participants": 128,
      "cta_wide_barriers": false
    }
  },
  "tensor_contract": {
    "features": {"dtype": "float32", "shape": ["N", 32]},
    "first_weights": {"dtype": "float16", "shape": [5, 128, 128]},
    "outputs": {
      "dtype": "float32",
      "order": ["position", "scale", "rotation", "opacity", "sh"],
      "widths": [3, 3, 4, 1, 48],
      "semantics": "delta"
    },
    "empty_rows": "valid_noop",
    "tail_rows": "zero-padded 16-row tile"
  },
  "ordering": {
    "raster_frame": "t",
    "deform_frame": "t+1",
    "executions_per_logical_task": 1,
    "zero_gaussians": "empty raster grid; non-empty deform task still runs once",
    "all_work_empty": "no physical kernel launch"
  },
  "python_binding": "rasterize_gaussians_with_deform_mlp",
  "python_method": "GaussianRasterizer.forward_with_deform_mlp",
  "capability_query": "tacker_capabilities",
  "resource_query": "tacker_resource_requirements",
  "build_resource_capture": "nvcc -Xptxas=-v"
}
